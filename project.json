{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "toohard",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": { "command": "expo start", "color": true },
      "description": "Start the Expo dev server (press i / a, or scan with Expo Go)"
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": { "command": "expo start --ios", "color": true },
      "description": "Open the app in the iOS simulator"
    },
    "android": {
      "executor": "nx:run-commands",
      "options": { "command": "expo start --android", "color": true },
      "description": "Open the app on an Android emulator or device"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "color": true }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint . --max-warnings=0", "color": true }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "jest", "color": true }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "command": "expo export --platform ios --output-dir .nx/bundle-check",
        "color": true
      },
      "description": "Prove the app still bundles without opening a simulator"
    },
    "verify": {
      "executor": "nx:run-commands",
      "options": { "commands": ["echo 'All checks passed.'"] },
      "dependsOn": ["typecheck", "lint", "test"],
      "description": "Every quality gate in one command"
    }
  }
}
